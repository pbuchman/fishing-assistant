[Unit]
Description=Fishing Assistant DEV process manager
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=@USER@
Environment=HOME=@HOME@
Environment=PATH=@PATH@
Environment=FA_DEV_HOSTNAME=home-dev
Environment=FA_DEV_REPO_PATH=@REPO@
Environment=FA_DEV_STATE_DIR=@STATE@
Environment=FA_DEV_REMOTE_URL=https://github.com/pbuchman/fishing-assistant.git
Environment=FA_PM2_HOME=@HOME@/.pm2-fa
Environment=PM2_HOME=@HOME@/.pm2-fa
UMask=0077
WorkingDirectory=@REPO@
ExecStart=/usr/bin/bash @REPO@/scripts/dev-host/start-prepared.sh
ExecReload=/usr/bin/bash @REPO@/scripts/dev-host/start-prepared.sh
ExecStop=/usr/bin/env -u PORT /usr/bin/direnv exec @REPO@ @PNPM@ exec pm2 kill
TimeoutStartSec=600
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
