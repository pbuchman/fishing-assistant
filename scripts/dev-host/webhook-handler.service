[Unit]
Description=Fishing Assistant durable deployment webhook
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Environment=HOME=@HOME@
Environment=PATH=@PATH@
Environment=FA_DEV_HOSTNAME=home-dev
Environment=FA_DEV_REPO_PATH=@REPO@
Environment=FA_DEV_STATE_DIR=@STATE@
Environment=FA_DEV_REMOTE_URL=https://github.com/pbuchman/fishing-assistant.git
Environment=FA_PM2_HOME=@HOME@/.pm2-fa
Environment=PM2_HOME=@HOME@/.pm2-fa
UMask=0077
WorkingDirectory=@REPO@
Environment=PORT=9001
Environment=FA_DEV_DEPLOY_SCRIPT=@REPO@/scripts/deploy/deploy-dev.sh
EnvironmentFile=@RUNTIME@/.env
ExecStart=/usr/bin/flock --no-fork --nonblock @STATE@/worker.lock @NODE@ @RUNTIME@/webhook-handler.mjs
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
